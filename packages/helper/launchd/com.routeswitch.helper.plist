<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  LaunchDaemon of the RouteSwitch helper. install-helper.sh copies it to
  /Library/LaunchDaemons (root:wheel 0644). Every value is checked against
  packages/shared/src/paths.ts and packages/helper/src/main.ts by
  tests/helper-install.test.ts.
  - KeepAlive: launchd restarts the helper whenever it exits (crash, exit 7).
  - ThrottleInterval: at most one start every 10 s (launchd's default, stated).
  - ExitTimeOut: after SIGTERM the helper removes every route it applied;
    launchd waits SHUTDOWN_EXIT_TIMEOUT_SEC (60) before SIGKILL.
  - StandardErrorPath: the helper writes its JSON-lines log to the same file
    itself; stderr only carries a failed log write or a crash.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.routeswitch.helper</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Library/PrivilegedHelperTools/com.routeswitch.helper</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>ExitTimeOut</key>
  <integer>60</integer>
  <key>StandardErrorPath</key>
  <string>/Library/Logs/RouteSwitch/helper.log</string>
</dict>
</plist>
